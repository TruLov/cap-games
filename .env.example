# SAP AI Core — Cross-Account-Zugang (service key JSON aus dem AI-Core-Subaccount)
# Vollständiges JSON aus "Service Key erstellen" in BTP Cockpit → AI-Core-Instanz → Service Keys
# Niemals committen — diese Datei ist nur eine Vorlage (.env ist gitignored)
AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"https://...","serviceurls":{"AI_API_URL":"https://api.ai.prod.us-east-1.aws.ml.hana.ondemand.com"}}'

# Deployment-ID des genutzten Modell-Deployments — primärer Ablageort
# (kein Secret, aber umgebungsspezifisch — deshalb hier statt in package.json)
AICORE_DEPLOYMENT_ID=d0a60fa69c65d580

# Um AI lokal zu testen ohne package.json anzufassen — direkter Override
# per Dot-Notation in .env (kein Profil-Wechsel nötig, betrifft nur diesen einen Pfad):
# cds.requires.kaffee-kwest.ai = aicore

# Resource Group (optional, default: 'default')
# AICORE_RESOURCE_GROUP=default
