# ── SAP AI Core access ────────────────────────────────────────────────────────
# The platform AI service (AiService, srv/ai-service.js) needs exactly two things
# locally; in production the Cloud Foundry service binding injects the first one.
#
# 1) AICORE_SERVICE_KEY — the AI-Core service-key JSON (clientid/clientsecret/auth
#    url/AI_API_URL). This is ONE secret credential blob, read natively by the SAP
#    AI SDK — do NOT split it into parts; that would fight the SDK and add config.
#    Get it from BTP Cockpit → AI-Core instance → Service Keys → "Create".
#    Never commit — this file is only a template (.env is gitignored).
AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"https://...","serviceurls":{"AI_API_URL":"https://api.ai.prod.us-east-1.aws.ml.hana.ondemand.com"}}'

# 2) AICORE_DEPLOYMENT_ID — the model deployment to use. The only non-secret but
#    environment-specific knob, so it lives here rather than in package.json.
#    (Everything else — resourceGroup, model name — has a sane default in
#    cds.requires.ai in the root package.json.)
AICORE_DEPLOYMENT_ID=d0a60fa69c65d580

# Without both of the above, AiService returns a deterministic mock in dev/CI
# (no credentials needed to run), and kaffee-kwest falls back to its static
# adapter — so a round always starts and ends.

# To exercise the real AI path locally for kaffee-kwest without editing
# package.json, force the plugin's own adapter flag via .env dot-notation
# (game-local choice, not platform config):
# cds.requires.kaffee-kwest.ai = aicore

# Resource Group (optional, default: 'default')
# AICORE_RESOURCE_GROUP=default
