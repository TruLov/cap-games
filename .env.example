# ── SAP AI Core (optional — only needed to run the REAL model) ────────────────
# The platform AiService picks its backend by profile (cds.requires.ai.kind):
#   default / [development] → mock    (deterministic stub, NO credentials needed)
#   [hybrid] / [production] → aicore  (real completions)
# So local dev and CI run with zero AI config; kaffee-kwest falls back to its own
# static adapter. The two vars below are only for exercising the real model.

# Full AI-Core service-key JSON — ONE secret; the SAP AI SDK reads it natively
# (env var locally, VCAP binding in prod, `cds bind` in hybrid). Do NOT split it.
# BTP Cockpit → AI-Core instance → Service Keys → "Create". Never commit.
AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"https://...","serviceurls":{"AI_API_URL":"https://api.ai.prod.us-east-1.aws.ml.hana.ondemand.com"}}'

# The model deployment to use (the only non-secret, environment-specific knob).
AICORE_DEPLOYMENT_ID=d0a60fa69c65d580

# The default profile stays on the mock backend even with the vars above set.
# To use the real backend locally, run an aicore profile, e.g.:
#   cds watch --profile hybrid
# or force it on the default profile via .env dot-notation:
#   cds.requires.ai.kind = aicore

# Resource Group (optional, default: 'default')
# AICORE_RESOURCE_GROUP=default
