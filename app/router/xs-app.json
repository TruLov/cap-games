{
  "authenticationMethod": "route",
  "websockets": { "enabled": true },
  "logout": { "logoutEndpoint": "/logout" },
  "routes": [
    {
      "source": "^/ws/(.*)$",
      "target": "/ws/$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": false
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": false
    },
    {
      "source": "^/games/(.*)$",
      "target": "/games/$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": false
    },
    {
      "source": "^/login.html$",
      "localDir": "resources",
      "authenticationType": "ias"
    },
    {
      "source": "^/(.*)$",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}
