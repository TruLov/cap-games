{
  "name": "cap-games",
  "version": "1.0.0",
  "description": "Gambito — multiplayer browser game platform on SAP BTP",
  "type": "module",
  "scripts": {
    "sync:approuter": "node scripts/sync-approuter.mjs",
    "prestart": "npm run sync:approuter || true",
    "predev": "npm run sync:approuter || true",
    "start": "cds-serve",
    "dev": "cds watch --include games",
    "lint": "eslint srv/ app/ games/ scripts/ test/",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "cds test -x integration",
    "test:int": "CDS_TEST_ENV_CHECK=y cds test integration"
  },
  "workspaces": [
    "games/*",
    "app/router"
  ],
  "dependencies": {
    "@cap-games/flipfortune": "*",
    "@cap-games/kaiten": "*",
    "@cap-games/kaperfahrt": "*",
    "@cap-games/mttt": "*",
    "@cap-games/tictactoe": "*",
    "@cap-js-community/websocket": "^1",
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "*",
    "@sap/cds-dk": "^10",
    "eslint": "^10.7.0"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "[production]": { "kind": "ias" }
      },
      "db": {
        "kind": "sqlite",
        "credentials": { "url": ":memory:" },
        "[production]": { "kind": "postgres" }
      }
    },
    "websocket": {
      "kind": "ws"
    }
  }
}
